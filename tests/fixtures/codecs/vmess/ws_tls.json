{
  "uri": "vmess:",
  "name": "vmess ws",
  "outbound": {
    "tag": "managed-node",
    "protocol": "vmess",
    "settings": {
      "vnext": [
        {
          "address": "vmess.example",
          "port": 443,
          "users": [
            {
              "id": "11111111-1111-4111-8111-111111111111",
              "security": "auto"
            }
          ]
        }
      ]
    },
    "streamSettings": {
      "network": "websocket",
      "security": "tls",
      "tlsSettings": {
        "serverName": "sni.example",
        "fingerprint": "chrome",
        "alpn": ["h2", "http/1.1"]
      },
      "wsSettings": {
        "path": "/vmess",
        "headers": {"Host": "cdn.example"}
      }
    }
  }
}
